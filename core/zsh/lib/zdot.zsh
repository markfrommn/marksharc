# -*- mode: shell-script; sh-shell: zsh -*-
# Generated ZDOTDIR (spec 6.6): one-line stubs under the state dir that source the
# core files. Regenerated only when a stub or the version marker is missing/stale.
# ZDOTDIR is set only once the stubs exist; if the state directory cannot be
# written, generation fails silently and ZDOTDIR is left as it was (HOME dotfiles
# then apply, which the doctor command reports).

typeset -g _ms_zdot_version=2

_ms_zdot_ensure() {
    emulate -L zsh
    local dir=${XDG_STATE_HOME:-$HOME/.local/state}/marksharc/zdot name
    local -a names=( zshenv zprofile zshrc zlogin )
    local ok=1
    [[ -r $dir/.version && $(<"$dir/.version") == $_ms_zdot_version ]] || ok=0
    for name in $names; do [[ -f $dir/.$name ]] || { ok=0; break; }; done
    if (( ! ok )); then
        _ms_trace "generating ZDOTDIR $dir"
        _ms_zdot_write "$dir" 2>/dev/null || { _ms_trace "ZDOTDIR $dir is not writable; leaving ZDOTDIR unchanged"; return 1; }
    fi
    ZDOTDIR=$dir
    return 0
}

_ms_zdot_write() {
    emulate -L zsh
    local dir=$1 name tmp
    command mkdir -p -- "$dir" || return 1
    for name in zshenv zprofile zshrc zlogin; do
        tmp=$dir/.$name.$$
        {
            print -r -- "# Generated by marksharc (zdot v$_ms_zdot_version); do not edit. Regenerated when stale."
            print -r -- "[[ -r \${MARKSHARC_HOME-}/core/zsh/$name.zsh ]] && source \"\$MARKSHARC_HOME/core/zsh/$name.zsh\""
        } > "$tmp" && command mv -f -- "$tmp" "$dir/.$name" || { command rm -f -- "$tmp"; return 1; }
    done
    print -r -- "$_ms_zdot_version" > "$dir/.version"
}
