# Bash emitter for the same parsed module and overlay directives as env.zsh.
_ms_render_bash_conf() {
    emulate -L zsh
    local file=$1 phase=$2 line kind name value guard
    [[ -r $file ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        _ms_words "$line" || continue
        kind=${reply[1]-} name=${reply[2]-} value=${reply[3]-}
        case $kind in
            env) [[ $phase == env && $name =~ '^[A-Za-z_][A-Za-z0-9_]*$' && $#reply -ge 3 ]] || continue ;;
            path) [[ $phase == env && $name =~ '^[A-Za-z0-9_-]+$' && -n $value ]] || continue ;;
            alias) [[ $phase == init && $name =~ '^[A-Za-z0-9_+.:-]+$' && $#reply -ge 3 ]] || continue ;;
            *) continue ;;
        esac
        _ms_render_guard_expression 4 || continue
        guard=$REPLY
        [[ -z $guard ]] || print -r -- "if $guard; then"
        case $kind in
            env) print -r -- "_ms_bash_env_export ${(qq)name} ${(qq)value}" ;;
            path) print -r -- "_ms_bash_add ${(qq)name} ${(qq)value}" ;;
            alias) print -r -- "_ms_bash_alias ${(qq)name} ${(qq)value}" ;;
        esac
        [[ -z $guard ]] || print -r -- 'fi'
    done < "$file"
}

_ms_render_bash_options() {
    emulate -L zsh
    local name=$1 key var value
    for key in ${=_ms_mod_options[$name]-}; do
        var=_ms_opt_${name//[^A-Za-z0-9]/_}_${key//[^A-Za-z0-9]/_}
        value=${_ms_cfg_set[$name.$key]-${_ms_mod_optdef[$name.$key]-}}
        print -r -- "_ms_bash_option $var ${(qq)value}"
    done
}

_ms_render_bash() {
    emulate -L zsh
    local config=${MARKSHARC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/marksharc}
    local name cmd module_env
    print -r -- '# Generated by marksharc render; do not edit.'
    print -r -- "# render id: $_ms_env_id_value"
    print -r -- "# home: ${(qq)HOME}"
    print -r -- "# framework: ${(qq)MARKSHARC_HOME}"
    print -r -- "# config: ${(qq)config}"
    print -r -- "MARKSHARC_OS=${(qq)MARKSHARC_OS}"
    print -r -- "MARKSHARC_ARCH=${(qq)MARKSHARC_ARCH}"
    print -r -- "MARKSHARC_HOST=${(qq)MARKSHARC_HOST}"
    print -r -- "MARKSHARC_DISTRO=${(qq)MARKSHARC_DISTRO}"
    print -r -- "_ms_bash_tiers=${(qq)${_ms_cfg_set[path.tiers]-}}"
    print -r -- "_ms_bash_dot=${(qq)${_ms_cfg_set[core.dot_in_path]-off}}"
    print -r -- "_ms_bash_pnpm=${(qq)${_ms_cfg_set[pnpm.path]-on}}"
    print -r -- "_ms_bash_agent_env=${(qq)${_ms_cfg_set[agent.bash_env]-off}}"
    print -r -- "_ms_bash_markers=${(qq)${_ms_cfg_set[agent.markers]-}}"
    print -r -- '_ms_bash_start'
    print -r -- "if [[ \${MARKSHARC_ENV-} != ${(qq)_ms_env_id_value} || \${_ms_bash_reloading-} == 1 ]] || shopt -q login_shell; then"
    for name in "${_ms_plan[@]}"; do
        _ms_render_bash_options "$name"
        for cmd in ${=_ms_mod_req_cmd[$name]-}; do
            print -r -- "if _ms_command_available ${(qq)cmd}; then"
        done
        print -r -- "_ms_bash_module ${(qq)name} ${(qq)_ms_mod_dir[$name]}"
        module_env=${_ms_mod_dir[$name]}/env.bash
        print -r -- "if [[ -r ${(qq)module_env} ]]; then source ${(qq)module_env} >/dev/null 2>&1 || :; fi"
        _ms_render_bash_conf "${_ms_mod_dir[$name]}/module.conf" env
        for cmd in ${=_ms_mod_req_cmd[$name]-}; do print -r -- 'fi'; done
    done
    _ms_render_bash_conf "$config/config.conf" env
    _ms_render_bash_conf "$config/hosts/$MARKSHARC_HOST.conf" env
    for name in "${_ms_plan[@]}"; do
        for cmd in ${=_ms_mod_req_cmd[$name]-}; do
            print -r -- "if _ms_command_available ${(qq)cmd}; then"
        done
        print -r -- "_ms_bash_module_bin ${(qq)_ms_mod_dir[$name]}"
        for cmd in ${=_ms_mod_req_cmd[$name]-}; do print -r -- 'fi'; done
    done
    print -r -- '_ms_bash_finish'
    print -r -- "export MARKSHARC_ENV=${(qq)_ms_env_id_value}"
    print -r -- 'fi'
}

_ms_render_bash_init() {
    emulate -L zsh
    local config=${MARKSHARC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/marksharc}
    local name cmd dir
    print -r -- '# Generated by marksharc render; do not edit.'
    print -r -- "# render id: $_ms_env_id_value"
    print -r -- "_ms_bash_notify ${(qq)${_ms_cfg_set[sync.check_hours]-12}}"
    for name in "${_ms_plan[@]}"; do
        case $name in zsh-options|fzf-fish) continue ;; esac
        dir=${_ms_mod_dir[$name]}
        for cmd in ${=_ms_mod_req_cmd[$name]-}; do
            print -r -- "if _ms_bash_require ${(qq)name} ${(qq)cmd}; then"
        done
        _ms_render_bash_options "$name"
        print -r -- "_ms_bash_load_module ${(qq)name} ${(qq)dir}"
        _ms_render_bash_conf "$dir/module.conf" init
        for cmd in ${=_ms_mod_req_cmd[$name]-}; do print -r -- 'fi'; done
    done
    _ms_render_bash_conf "$config/config.conf" init
    _ms_render_bash_conf "$config/hosts/$MARKSHARC_HOST.conf" init
    print -r -- '_ms_bash_load_completions'
    print -r -- "_ms_bash_load_file ${(qq)config}/local/post.bash"
}
