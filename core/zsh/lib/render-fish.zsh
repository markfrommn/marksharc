# Render the shared declarative configuration as native fish statements.
_ms_fish_quote() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//\'/\\\'}
    REPLY="'$value'"
}

_ms_fish_render_conf() {
    local file=$1 line kind name value guard type arg command quoted word alias_body alias_name alias_args
    local -a alias_words
    integer i
    [[ -r $file ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        _ms_words "$line" || continue
        kind=${reply[1]-} name=${reply[2]-} value=${reply[3]-}
        [[ $kind == (env|path|alias) && $#reply -ge 3 ]] || continue
        case $kind in
            env) [[ $name =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] || continue ;;
            path) [[ $name =~ '^[A-Za-z0-9_-]+$' && -n $value ]] || continue ;;
            alias) [[ $name =~ '^[A-Za-z_][A-Za-z0-9_.-]*$' ]] || continue ;;
        esac
        guard=
        for (( i=4; i <= $#reply; i+=3 )); do
            [[ ${reply[i]} == when && -n ${reply[i+2]-} ]] || { guard=skip; break; }
            type=${reply[i+1]} arg=${reply[i+2]}
            _ms_fish_quote "$arg"; quoted=$REPLY
            case $type in
                os) [[ $arg == "$MARKSHARC_OS" ]] || { guard=skip; break; }; continue ;;
                host) [[ $arg == "$MARKSHARC_HOST" ]] || { guard=skip; break; }; continue ;;
                command) command="_ms_fish_command_available $quoted" ;;
                dir) command="test -d $quoted" ;;
                file) command="test -f $quoted" ;;
                *) guard=skip; break ;;
            esac
            [[ -z $guard ]] || guard+='; and '
            guard+=$command
        done
        [[ $guard == skip ]] && continue
        if [[ $kind == (env|path) ]]; then
            [[ -z $guard ]] || guard="; and $guard"
            guard='test "$_ms_fish_rebuild" = 1'$guard
        fi
        _ms_fish_quote "$value"; quoted=$REPLY
        case $kind in
            env) command="begin; set -gx $name $quoted; contains -- $name \$_ms_fish_exports; or set -ga _ms_fish_exports $name; end" ;;
            path) command="_ms_fish_path_add $name $quoted" ;;
            alias)
                _ms_words "$value" || continue
                alias_words=( "${reply[@]}" )
                command=
                for word in "${alias_words[@]}"; do
                    _ms_fish_quote "$word"
                    command+="$REPLY "
                done
                alias_name=$name
                _ms_fish_quote "$name"; name=$REPLY
                if [[ ${alias_words[1]} == "$alias_name" ]]; then
                    alias_args=
                    for word in "${alias_words[@]:1}"; do
                        _ms_fish_quote "$word"
                        alias_args+="$REPLY "
                    done
                    alias_body="if contains -- $name (builtin --names); set -l _ms_alias_target $name; builtin \$_ms_alias_target $alias_args\$argv; else; command $command\$argv; end"
                else
                    alias_body="$command\$argv"
                fi
                command="if test \"\$MARKSHARC_SESSION\" = interactive; function $name; $alias_body; end; contains -- $name \$_ms_fish_aliases; or set -ga _ms_fish_aliases $name; end"
                ;;
        esac
        if [[ -n $guard ]]; then
            print -r -- "if $guard; $command; end"
        else
            print -r -- "$command"
        fi
    done < "$file"
}

_ms_fish_render_module() {
    local name=$1 key optvar module_name
    _ms_fish_quote "$name"; module_name=$REPLY
    print -r -- "set -ga _ms_fish_enabled_modules $module_name"
    if [[ $name == path ]]; then
        _ms_fish_quote "${_ms_cfg_set[path.tiers]-}"
        print -r -- "if test \"\$_ms_fish_rebuild\" = 1; _ms_fish_path_begin $REPLY; end"
    fi
    for key in ${=_ms_mod_options[$name]-}; do
        optvar=_ms_opt_${name//[^A-Za-z0-9]/_}_${key//[^A-Za-z0-9]/_}
        _ms_fish_quote "${(P)optvar}"
        if [[ $name == git-worktree && $key == (roots|orgs) ]]; then
            print -r -- "set -gx $optvar $REPLY"
            print -r -- "contains -- $optvar \$_ms_fish_exports; or set -ga _ms_fish_exports $optvar"
        else
            print -r -- "set -g $optvar $REPLY"
        fi
    done
    _ms_fish_quote "$name"
    print -r -- "if test \"\$_ms_fish_rebuild\" = 1; _ms_fish_module_env $REPLY; end"
    _ms_fish_quote "${_ms_mod_dir[$name]}/env.fish"
    print -r -- "if test \"\$_ms_fish_rebuild\" = 1; and test -r $REPLY; source $REPLY; end"
    _ms_fish_render_conf "${_ms_mod_dir[$name]}/module.conf"
}

_ms_render_fish() {
    local name cmd line plugin_name plugin_sha marker module_name body reason
    local -a markers=()
    integer path_enabled=0
    local config=${MARKSHARC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/marksharc}
    print -r -- '# Generated by marksharc render; do not edit.'
    print -r -- "# render id: $_ms_env_id_value"
    for marker in ${=_ms_cfg_set[agent.markers]-}; do
        [[ $marker =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] && markers+=( "$marker" )
    done
    print -r -- "# agent markers: ${(j: :)markers}"
    print -r -- 'set -q _ms_fish_rebuild; or set -g _ms_fish_rebuild 1'
    _ms_fish_quote "$_ms_env_id_value"
    print -r -- "set -gx MARKSHARC_ENV $REPLY"
    _ms_fish_quote "$MARKSHARC_OS"
    print -r -- "set -g MARKSHARC_OS $REPLY"
    _ms_fish_quote "$MARKSHARC_ARCH"
    print -r -- "set -g MARKSHARC_ARCH $REPLY"
    _ms_fish_quote "$MARKSHARC_HOST"
    print -r -- "set -g MARKSHARC_HOST $REPLY"
    _ms_fish_quote "$MARKSHARC_DISTRO"
    print -r -- "set -g MARKSHARC_DISTRO $REPLY"
    _ms_fish_quote "${_ms_cfg_set[core.dot_in_path]-off}"
    print -r -- "set -g _ms_fish_dot_in_path $REPLY"
    print -r -- 'set -g _ms_fish_enabled_modules'
    for name in "${_ms_plan[@]}"; do
        _ms_module_options "$name"
        [[ $name == path ]] && path_enabled=1
        if [[ -n ${_ms_mod_req_cmd[$name]-} ]]; then
            print -n -r -- 'if '
            for cmd in ${=_ms_mod_req_cmd[$name]}; do
                _ms_fish_quote "$cmd"
                print -n -r -- "_ms_fish_command_available $REPLY; and "
            done
            print -r -- 'true'
        fi
        body=$(_ms_fish_render_module "$name") || return 1
        _ms_fish_quote "$name"; module_name=$REPLY
        print -r -- 'if test "$_ms_fish_verbose" = 1'
        print -r -- "    printf 'marksharc: module %s env\n' $module_name >&2"
        print -r -- '    time begin'
        print -r -- "$body"
        print -r -- '    end'
        print -r -- 'else'
        print -r -- "$body"
        print -r -- 'end'
        if [[ -n ${_ms_mod_req_cmd[$name]-} ]]; then
            reason="module $name: skipped (requires command ${_ms_mod_req_cmd[$name]})"
            _ms_fish_quote "$reason"
            print -r -- 'else'
            print -r -- "    if test \"\$_ms_fish_verbose\" = 1; printf 'marksharc: %s\n' $REPLY >&2; end"
            print -r -- end
        fi
    done
    for name in "${_ms_mod_names[@]}"; do
        (( ${_ms_plan[(Ie)$name]} )) && continue
        reason="module $name: skipped (requires os ${_ms_mod_req_os[$name]-})"
        _ms_fish_quote "$reason"
        print -r -- "if test \"\$_ms_fish_verbose\" = 1; printf 'marksharc: %s\n' $REPLY >&2; end"
    done
    _ms_fish_render_conf "$config/config.conf"
    _ms_fish_render_conf "$config/hosts/$MARKSHARC_HOST.conf"
    if (( path_enabled )); then
        _ms_fish_quote "${XDG_CACHE_HOME:-$HOME/.cache}/marksharc/$MARKSHARC_HOST/bin"
        print -r -- "if test \"\$_ms_fish_rebuild\" = 1; and test -d $REPLY; _ms_fish_path_add_force user $REPLY; end"
        for name in "${_ms_plan[@]}"; do
            [[ -d ${_ms_mod_dir[$name]}/bin ]] || continue
            _ms_fish_quote "$name"; module_name=$REPLY
            _ms_fish_quote "${_ms_mod_dir[$name]}/bin"
            print -r -- "if test \"\$_ms_fish_rebuild\" = 1; and contains -- $module_name \$_ms_fish_enabled_modules; _ms_fish_path_add_force user $REPLY; end"
        done
        print -r -- 'if test "$_ms_fish_rebuild" = 1; _ms_fish_path_build; end'
    fi
    print -r -- 'if test "$MARKSHARC_SESSION" = interactive'
    for name in "${_ms_plan[@]}"; do
        _ms_fish_quote "$name"
        print -r -- "  if contains -- $REPLY \$_ms_fish_enabled_modules"
        _ms_fish_quote "${_ms_mod_dir[$name]}"
        body=$REPLY
        _ms_fish_quote "$name"
        print -r -- '    if test "$_ms_fish_verbose" = 1'
        print -r -- "      printf 'marksharc: module %s init\n' $REPLY >&2"
        print -r -- "      time _ms_fish_init_module $body"
        print -r -- '    else'
        print -r -- "      _ms_fish_init_module $body"
        print -r -- '    end'
        if [[ -r ${_ms_mod_dir[$name]}/fish.plugins ]]; then
            while IFS= read -r line || [[ -n $line ]]; do
                _ms_words "$line" || continue
                [[ ${reply[1]-} == plugin && -n ${reply[2]-} && -n ${reply[4]-} ]] || continue
                _ms_fish_quote "${reply[2]}"; plugin_name=$REPLY
                _ms_fish_quote "${reply[4]}"; plugin_sha=$REPLY
                print -r -- "    _ms_fish_plugin_load $plugin_name $plugin_sha"
            done < "${_ms_mod_dir[$name]}/fish.plugins"
        fi
        print -r -- '  end'
    done
    _ms_fish_quote "$config/local/post.fish"
    print -r -- "    if test -r $REPLY; source $REPLY; end"
    print -r -- 'end'
}
