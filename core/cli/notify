#!/usr/bin/env zsh
# Private worker: a detached, throttled fetch that never merges or refreshes plugins.
emulate -L zsh
[[ ${1-} == --check && $# == 1 ]] || exit 2
export GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never GIT_ASKPASS=/usr/bin/false SSH_ASKPASS=/usr/bin/false SSH_ASKPASS_REQUIRE=force
config=${MARKSHARC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/marksharc}
host=${MARKSHARC_HOST:-${HOST%%.*}}
dir=${XDG_CACHE_HOME:-$HOME/.cache}/marksharc/$host/sync
command mkdir -p -- "$dir" || exit 1
if ! command mkdir -- "$dir/lock" 2>/dev/null; then
    # A dead worker may leave a lock after SIGKILL or reboot. Reap only an old
    # directory whose recorded owner is gone; a nested mkdir serializes reapers.
    zmodload -F zsh/stat b:zstat 2>/dev/null || exit 0
    typeset -A lock_before lock_after
    zstat -H lock_before -- "$dir/lock" 2>/dev/null || exit 0
    now=$(command date +%s) || exit 0
    (( now - lock_before[mtime] >= 900 )) || exit 0
    command mkdir -- "$dir/lock/reap" 2>/dev/null || exit 0
    zstat -H lock_after -- "$dir/lock" 2>/dev/null || exit 0
    owner=
    [[ -r $dir/lock/pid ]] && IFS= read -r owner < "$dir/lock/pid"
    if [[ ${lock_before[inode]} == ${lock_after[inode]} ]] && { [[ $owner != <-> ]] || ! kill -0 "$owner" 2>/dev/null; }; then
        command rm -f -- "$dir/lock/pid"
        command rmdir -- "$dir/lock/reap" "$dir/lock" 2>/dev/null || exit 0
        command mkdir -- "$dir/lock" 2>/dev/null || exit 0
    else
        command rmdir -- "$dir/lock/reap" 2>/dev/null
        exit 0
    fi
fi
print -r -- $$ > "$dir/lock/pid" || exit 1
trap 'command rm -f -- "$dir/lock/pid"; command rmdir -- "$dir/lock" 2>/dev/null' EXIT
trap 'exit 1' HUP INT TERM
source "$MARKSHARC_HOME/core/zsh/lib/modules.zsh"
_ms_config_load
hours=${_ms_cfg_set[sync.check_hours]-12}
[[ $hours == <-> ]] || hours=12
now=$(command date +%s) || exit 1
last=0
[[ -r $dir/checked ]] && IFS= read -r last < "$dir/checked"
[[ $last == <-> ]] || last=0
(( now >= last && now - last < hours * 3600 )) && exit 0
print -r -- "$now" > "$dir/checked" || exit 1
generation=
[[ -r $dir/generation ]] && IFS= read -r generation < "$dir/generation"
typeset -a candidates=( "$MARKSHARC_HOME" "$config" )
for conf in "$config/config.conf" "$config/hosts/$host.conf"; do
    [[ -r $conf ]] || continue
    while IFS= read -r line || [[ -n $line ]]; do
        _ms_words "$line" || continue
        [[ ${reply[1]} == set && ${reply[2]-} == sync.repos ]] && candidates+=( "${reply[@]:2}" )
    done < "$conf"
done
typeset -A seen=()
result=current
for candidate in "${candidates[@]}"; do
    [[ -d $candidate ]] || continue
    root=$(command git -C "${candidate:A}" rev-parse --show-toplevel 2>/dev/null) || continue
    root=${root:A}
    [[ -n ${seen[$root]-} ]] && continue
    seen[$root]=1
    branch=$(command git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null) || continue
    remote=$(command git -C "$root" config --get "branch.$branch.remote" 2>/dev/null) || continue
    if ! command git -C "$root" fetch --quiet -- "$remote" >/dev/null 2>&1; then result=unknown; continue; fi
    counts=$(command git -C "$root" rev-list --left-right --count 'HEAD...@{upstream}' 2>/dev/null) || { result=unknown; continue; }
    typeset -a parts=( ${=counts} )
    (( parts[2] > 0 )) && { result=behind; break; }
done
print -r -- "$result${generation:+|$generation}" > "$dir/status.tmp.$$" && command mv -f -- "$dir/status.tmp.$$" "$dir/status"
