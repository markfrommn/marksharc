#!/usr/bin/env zsh
# Read-only diagnostics for the local marksharc installation.
emulate -L zsh
(( $# == 0 )) || { print -ru2 -- 'Usage: marksharc doctor'; exit 2; }
source "$MARKSHARC_HOME/core/zsh/lib/util.zsh"
source "$MARKSHARC_HOME/core/zsh/lib/modules.zsh"
_ms_verbose=0
_ms_modules_discover
integer issues=0
config=${MARKSHARC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/marksharc}
if [[ ! -r $HOME/.zshenv ]]; then
    print -r -- "doctor: missing stub: $HOME/.zshenv"
    (( ++issues ))
else
    IFS= read -r first_line < "$HOME/.zshenv"
    if [[ $first_line != '# marksharc: managed stub'* ]]; then
        print -r -- "doctor: unmanaged or modified stub: $HOME/.zshenv"
        (( ++issues ))
    elif [[ -r ${XDG_STATE_HOME:-$HOME/.local/state}/marksharc/install.manifest ]]; then
        expected_sum=
        while IFS= read -r line; do
            [[ $line == stub_sum=* ]] && { expected_sum=${line#stub_sum=}; break; }
        done < "${XDG_STATE_HOME:-$HOME/.local/state}/marksharc/install.manifest"
        actual_sum=$(command cksum < "$HOME/.zshenv")
        if [[ -n $expected_sum && $actual_sum != "$expected_sum" ]]; then
            print -r -- "doctor: modified stub: $HOME/.zshenv"
            (( ++issues ))
        fi
    fi
fi
manifest=${XDG_STATE_HOME:-$HOME/.local/state}/marksharc/install.manifest
fish_stub= fish_sum=
if [[ -r $manifest ]]; then
    while IFS= read -r line; do
        case $line in
            fish_stub=*) fish_stub=${line#fish_stub=} ;;
            fish_stub_sum=*) fish_sum=${line#fish_stub_sum=} ;;
        esac
    done < "$manifest"
fi
if [[ -n $fish_stub ]]; then
    fish_config=${${XDG_CONFIG_HOME:-$HOME/.config}%/}
    if [[ $fish_stub != "$fish_config/fish/conf.d/00-marksharc.fish" || ! -f $fish_stub || -L $fish_stub ]]; then
        print -r -- "doctor: missing or unmanaged fish stub: $fish_stub"
        (( ++issues ))
    elif [[ -n $fish_sum && $(command cksum < "$fish_stub") != "$fish_sum" ]]; then
        print -r -- "doctor: modified fish stub: $fish_stub"
        (( ++issues ))
    fi
fi
if [[ -L $config && ! -e $config ]]; then
    print -r -- "doctor: broken link: $config"
    (( ++issues ))
fi
source "$MARKSHARC_HOME/core/zsh/lib/zdot.zsh"
zdot=${XDG_STATE_HOME:-$HOME/.local/state}/marksharc/zdot
for name in zshenv zprofile zshrc zlogin; do
    expected="# Generated by marksharc (zdot v$_ms_zdot_version); do not edit. Regenerated when stale."$'\n'"[[ -r \${MARKSHARC_HOME-}/core/zsh/$name.zsh ]] && source \"\$MARKSHARC_HOME/core/zsh/$name.zsh\""
    if [[ ! -r $zdot/.$name || $(<"$zdot/.$name") != "$expected" ]]; then
        print -r -- "doctor: stale generated stub: $zdot/.$name"
        (( ++issues ))
    fi
done
if [[ ! -r $zdot/.version || $(<"$zdot/.version") != $_ms_zdot_version ]]; then
    print -r -- "doctor: stale generated stub version: $zdot/.version"
    (( ++issues ))
fi
for dotfile in "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.zlogin" "$HOME/.zlogout" "$HOME/.bashrc" "${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"; do
    if [[ -e $dotfile || -L $dotfile ]]; then
        print -r -- "doctor: foreign dotfile: $dotfile"
        if [[ -r $dotfile ]]; then
            integer line_no=0
            while IFS= read -r foreign_line || [[ -n $foreign_line ]]; do
                (( ++line_no ))
                print -r -- "  $line_no: $foreign_line"
            done < "$dotfile"
        fi
        (( ++issues ))
    fi
done
typeset -A path_seen=()
typeset -a inspected_path=( "${path[@]}" )
if (( ${+MARKSHARC_DOCTOR_PATH} )); then inspected_path=( "${(@s/:/)MARKSHARC_DOCTOR_PATH}" ); fi
for entry in "${inspected_path[@]}"; do
    [[ -n $entry ]] || continue
    if [[ -n ${path_seen[$entry]-} ]]; then
        print -r -- "doctor: duplicate PATH: $entry"
        (( ++issues ))
    fi
    path_seen[$entry]=1
done
typeset -a candidates=( "$MARKSHARC_HOME" "$config" )
typeset -a extras=()
for conf in "$config/config.conf" "$config/hosts/${MARKSHARC_HOST:-${HOST%%.*}}.conf"; do
    [[ -r $conf ]] || continue
    while IFS= read -r line || [[ -n $line ]]; do
        _ms_words "$line" || continue
        if [[ ${reply[1]} == set && ${reply[2]-} == sync.repos ]] && (( $#reply >= 3 )); then
            extras=( "${reply[@]:2}" )
        fi
    done < "$conf"
done
candidates+=( "${extras[@]}" )
typeset -A seen=()
for candidate in "${candidates[@]}"; do
    [[ -d $candidate ]] || continue
    root=$(command git -C "${candidate:A}" rev-parse --show-toplevel 2>/dev/null) || continue
    root=${root:A}
    [[ -n ${seen[$root]-} ]] && continue
    seen[$root]=1
    if ! tree=$(command git -C "$root" status --porcelain --untracked-files=normal 2>/dev/null); then
        print -r -- "doctor: cannot inspect repository: $root"
        (( ++issues ))
    elif [[ -n $tree ]]; then
        print -r -- "doctor: dirty repository: $root"
        (( ++issues ))
    fi
    counts=$(command git -C "$root" rev-list --left-right --count 'HEAD...@{upstream}' 2>/dev/null) || continue
    typeset -a parts=( ${=counts} )
    if (( parts[1] > 0 || parts[2] > 0 )); then
        print -r -- "doctor: repository ahead ${parts[1]}, behind ${parts[2]}: $root"
        (( ++issues ))
    fi
done
inherited_id=${MARKSHARC_DOCTOR_ENV-${MARKSHARC_ENV-}}
if [[ -n $inherited_id ]]; then
    source "$MARKSHARC_HOME/core/zsh/lib/facts.zsh"
    source "$MARKSHARC_HOME/core/zsh/lib/envid.zsh"
    _ms_facts
    # The installer preserves a logical framework path, while the CLI resolves
    # its own path physically. The env ID hashes input paths as well as metadata.
    original_home=$MARKSHARC_HOME
    manifest=${XDG_STATE_HOME:-$HOME/.local/state}/marksharc/install.manifest
    if [[ -r $manifest ]]; then
        while IFS= read -r line; do
            if [[ $line == framework=* ]]; then
                installed_home=${line#framework=}
                [[ -d $installed_home && ${installed_home:A} == ${original_home:A} ]] && MARKSHARC_HOME=$installed_home
                break
            fi
        done < "$manifest"
    fi
    _ms_env_id
    MARKSHARC_HOME=$original_home
    if [[ -n $_ms_env_id_value && $inherited_id != $_ms_env_id_value ]]; then
        print -r -- 'doctor: stale environment ID (open a new shell or reload)'
        (( ++issues ))
    fi
fi
for name in "${_ms_mod_names[@]}"; do
    # "requires command" is a load condition: a module enabled by default skips itself
    # when the command is absent. Only a module the overlay names explicitly must have it.
    if [[ ${_ms_cfg_enabled[$name]-} == 1 ]]; then
        for required in ${=_ms_mod_req_cmd[$name]-}; do
            if ! whence -p -- "$required" >/dev/null 2>&1; then
                print -r -- "doctor: missing command: $required ($name)"
                (( ++issues ))
            fi
        done
    fi
    for registry in "${_ms_mod_dir[$name]}/zsh.plugins" "${_ms_mod_dir[$name]}/fish.plugins"; do
      [[ -r $registry ]] || continue
      while IFS= read -r line || [[ -n $line ]]; do
        _ms_words "$line" || continue
        [[ ${reply[1]} == plugin && -n ${reply[2]-} && -n ${reply[4]-} ]] || continue
        plugin_dir=${XDG_CACHE_HOME:-$HOME/.cache}/marksharc/plugins/${reply[2]}@${reply[4]}
        if [[ ! -d $plugin_dir/.git ]] || [[ $(command git -C "$plugin_dir" rev-parse HEAD 2>/dev/null) != ${reply[4]} ]]; then
            print -r -- "doctor: missing plugin or incorrect pin: ${reply[2]} (run marksharc update)"
            (( ++issues ))
        fi
      done < "$registry"
    done
done
budget=${_ms_cfg_set[doctor.startup_ms]-500}
[[ $budget == <-> ]] || budget=500
timeout_ms=${_ms_cfg_set[doctor.startup_timeout_ms]-5000}
[[ $timeout_ms == <1-> ]] || timeout_ms=5000
if zmodload zsh/datetime 2>/dev/null && zmodload zsh/zpty 2>/dev/null && zmodload zsh/zselect 2>/dev/null; then
    started=$EPOCHREALTIME
    output=
    # A PTY makes the child an eligible interactive session. The marker also
    # verifies its session class and exit status; never launch notify from timing.
    if zpty -b msdoctor "unset CLAUDECODE AI_AGENT CODEX_SESSION_ID CODEX_SANDBOX OPENCODE GEMINI_CLI CURSOR_AGENT COPILOT_CLI KILO_CLI_MODE VSCODE_INJECTION VSCODE_NONCE; MARKSHARC_NOTIFY=0 zsh -ic '[[ \$MARKSHARC_SESSION == interactive ]] && print -r -- __MS_INTERACTIVE_OK__'; print -r -- __MS_CHILD_STATUS__\$?"; then
        while (( (EPOCHREALTIME - started) * 1000 < timeout_ms )); do
            while zpty -r -t msdoctor chunk 2>/dev/null; do output+=$chunk; done
            [[ $output == *__MS_CHILD_STATUS__* ]] && break
            zpty -t msdoctor || break
            zselect -t 5 2>/dev/null
        done
        while zpty -r -t msdoctor chunk 2>/dev/null; do output+=$chunk; done
        zpty -d msdoctor 2>/dev/null
    fi
    elapsed=$(( (EPOCHREALTIME - started) * 1000 ))
    if [[ $output != *__MS_CHILD_STATUS__* ]] && (( elapsed >= timeout_ms )); then
        print -r -- "doctor: interactive startup timed out after $timeout_ms ms"
        (( ++issues ))
    elif [[ $output != *__MS_INTERACTIVE_OK__* || $output != *__MS_CHILD_STATUS__0* ]]; then
        print -r -- 'doctor: interactive startup failed'
        (( ++issues ))
    elif (( elapsed > budget )); then
        printf 'doctor: startup budget exceeded: %.1f ms (budget %s ms)\n' "$elapsed" "$budget"
        (( ++issues ))
    else
        printf 'doctor: interactive startup %.1f ms (budget %s ms)\n' "$elapsed" "$budget"
    fi
else
    print -r -- 'doctor: interactive startup timing unavailable (zsh modules missing)'
    (( ++issues ))
fi
print -r -- "doctor: $issues issue(s)"
exit 0
