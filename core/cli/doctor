#!/usr/bin/env zsh
# Read-only diagnostics for the local marksharc installation.
emulate -L zsh
(( $# == 0 )) || { print -ru2 -- 'Usage: marksharc doctor'; exit 2; }
source "$MARKSHARC_HOME/core/zsh/lib/util.zsh"
source "$MARKSHARC_HOME/core/zsh/lib/modules.zsh"
_ms_verbose=0
_ms_modules_discover
integer issues=0
bash_version=${MARKSHARC_BASH_VERSION-}
if [[ -z $bash_version ]]; then
    bash_path=${SHELL-}
    [[ $bash_path == */bash && -x $bash_path ]] || bash_path=$(whence -p -- bash)
    if [[ -n $bash_path ]]; then
        bash_version=$(BASH_ENV='' "$bash_path" --noprofile --norc -c 'printf %s "$BASH_VERSION"')
    fi
fi
if [[ $bash_version == <->.<->* ]]; then
    bash_major=${bash_version%%.*}
    bash_minor=${${bash_version#*.}%%.*}
    if (( bash_major < 4 || (bash_major == 4 && bash_minor < 4) )); then
        print -r -- "doctor: Bash $bash_version is environment-only; interactive MarkSharc requires Bash 4.4 or newer"
    elif [[ -n ${MARKSHARC_BASH_BACKENDS-} ]]; then
        print -r -- "doctor: Bash $bash_version active=${MARKSHARC_BASH_BACKENDS} pending=${MARKSHARC_BASH_PENDING}"
        if [[ $MARKSHARC_BASH_BACKENDS == readline/* ]]; then
            print -r -- 'doctor: Readline provides native completion and listing; ble.sh adds suggestions, highlighting and a completion menu'
        fi
        if [[ $MARKSHARC_BASH_BACKENDS == */native && ${_ms_mod_enabled[completion]-0} == 1 ]]; then
            print -r -- 'doctor: Bash uses built-in completion; install bash-completion for additional commands'
        fi
    fi
fi
if [[ ${_ms_mod_enabled[line-editor-ble]-0} == 1 ]]; then
    ble_dir=${_ms_mod_dir[line-editor-ble]}
    if [[ -r $ble_dir/ble.pin ]]; then
        IFS= read -r ble_pin < "$ble_dir/ble.pin"
        ble_file=${XDG_CACHE_HOME:-$HOME/.cache}/marksharc/plugins/ble.sh@$ble_pin/out/ble.sh
        if [[ ! -r $ble_file ]]; then
            print -r -- 'doctor: optional Bash editor ble.sh is missing (run marksharc install ble.sh)'
            "$ble_dir/support/acquire-ble" --check-prerequisites 2>&1 || :
        elif [[ ${MARKSHARC_BASH_BACKENDS-} == readline/* && ${MARKSHARC_BASH_PENDING-} == ble/* ]]; then
            print -r -- "doctor: ble.sh is available; run 'exec bash -l' to select it in a fresh shell"
        fi
    fi
fi
case ${MARKSHARC_BASH_HISTORY-} in
    atuin-bash-preexec)
        print -r -- 'doctor: Bash history uses Atuin with bash-preexec; duration and exit status can be incomplete for some commands' ;;
    atuin-unavailable)
        print -r -- 'doctor: Atuin could not initialize recording in this Bash session; native history remains available' ;;
esac
mise_tools=${_ms_cfg_set[mise.tools]-${_ms_mod_optdef[mise.tools]-}}
mise_version_files=${_ms_cfg_set[mise.version_files]-${_ms_mod_optdef[mise.version_files]-on}}
typeset -a mise_tool_list=( ${=mise_tools} )
integer mise_available=0 mise_owns_node=0 mise_owns_python=0
whence -p -- mise >/dev/null 2>&1 && mise_available=1
if [[ ${_ms_mod_enabled[mise]-0} == 1 ]] && (( mise_available )); then
    (( ${mise_tool_list[(Ie)node]} )) && mise_owns_node=1
    (( ${mise_tool_list[(Ie)python]} )) && mise_owns_python=1
fi
if [[ -n ${mise_tools//[[:space:]]/} ]] && (( ! mise_available )); then
    print -r -- 'doctor: mise.tools is nonempty but mise is missing'
    (( ++issues ))
fi
if (( mise_owns_python )) && [[ $mise_version_files == (on|1|yes|true) && -r $HOME/.python-version ]]; then
    IFS= read -r mise_python_pin < "$HOME/.python-version"
    if [[ $mise_python_pin == cpython-*-any-any-any ]]; then
        print -r -- "doctor: $HOME/.python-version contains a uv Python pin; move or rewrite it for mise"
        (( ++issues ))
    fi
fi
carapace_enable=${_ms_cfg_set[completion-carapace.enable]-${_ms_mod_optdef[completion-carapace.enable]-off}}
integer carapace_wanted=0 carapace_available=0 carapace_active=0 carapace_allow_fzf_tab=0
if [[ ${_ms_mod_enabled[completion-carapace]-0} == 1 ]]; then
    if [[ $carapace_enable == (on|1|yes|true) ]] || [[ ${_ms_cfg_enabled[completion-carapace]-0} == 1 && -z ${_ms_cfg_set[completion-carapace.enable]+x} ]]; then
        carapace_wanted=1
    fi
fi
whence -p -- carapace >/dev/null 2>&1 && carapace_available=1
if (( carapace_wanted && carapace_available )); then
    carapace_active=1
    [[ ${_ms_cfg_set[completion-carapace.allow_fzf_tab]-${_ms_mod_optdef[completion-carapace.allow_fzf_tab]-off}} == (on|1|yes|true) ]] && carapace_allow_fzf_tab=1
fi
if (( carapace_wanted && ! carapace_available )) && [[ ${_ms_cfg_enabled[completion-carapace]-0} != 1 ]]; then
    print -r -- 'doctor: missing command: carapace (completion-carapace)'
    (( ++issues ))
fi
config=${MARKSHARC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/marksharc}
manifest=${XDG_STATE_HOME:-$HOME/.local/state}/marksharc/install.manifest
install_mode=takeover expected_sum= fish_stub= fish_sum= bash_sum=
coexist_zshenv= coexist_zshenv_sum= coexist_zshrc= coexist_zshrc_sum=
if [[ -r $manifest ]]; then
    while IFS= read -r line; do
        case $line in
            mode=*) install_mode=${line#mode=} ;;
            stub_sum=*) [[ -n $expected_sum ]] || expected_sum=${line#stub_sum=} ;;
            fish_stub=*) fish_stub=${line#fish_stub=} ;;
            fish_stub_sum=*) fish_sum=${line#fish_stub_sum=} ;;
            bash_stub_sum=*) bash_sum=${line#bash_stub_sum=} ;;
            coexist_zshenv=*) coexist_zshenv=${line#coexist_zshenv=} ;;
            coexist_zshenv_sum=*) coexist_zshenv_sum=${line#coexist_zshenv_sum=} ;;
            coexist_zshrc=*) coexist_zshrc=${line#coexist_zshrc=} ;;
            coexist_zshrc_sum=*) coexist_zshrc_sum=${line#coexist_zshrc_sum=} ;;
        esac
    done < "$manifest"
fi
bash_sum=${(j: :)${=bash_sum}}
if [[ $install_mode == coexist ]]; then
    for coexist_dot in "$HOME/.zshenv" "$HOME/.zshrc"; do
        if [[ ! -r $coexist_dot ]] || ! command grep -Fq '# marksharc: coexist' "$coexist_dot"; then
            print -r -- "doctor: missing coexist source line: $coexist_dot"
            (( ++issues ))
        fi
    done
    check_coexist_stub() {
        local file=$1 want=$2 actual
        if [[ -z $file || ! -f $file || -L $file ]]; then
            print -r -- "doctor: missing or unmanaged coexist stub: ${file:-unknown}"
            (( ++issues ))
        elif [[ -n $want ]]; then
            actual=$(command cksum < "$file")
            actual=${(j: :)${=actual}}
            if [[ $actual != "${(j: :)${=want}}" ]]; then
                print -r -- "doctor: modified coexist stub: $file"
                (( ++issues ))
            fi
        fi
    }
    check_coexist_stub "$coexist_zshenv" "$coexist_zshenv_sum"
    check_coexist_stub "$coexist_zshrc" "$coexist_zshrc_sum"
else
    if [[ ! -r $HOME/.zshenv ]]; then
        print -r -- "doctor: missing stub: $HOME/.zshenv"
        (( ++issues ))
    else
        IFS= read -r first_line < "$HOME/.zshenv"
        if [[ $first_line != '# marksharc: managed stub'* ]]; then
            print -r -- "doctor: unmanaged or modified stub: $HOME/.zshenv"
            (( ++issues ))
        elif [[ -n $expected_sum ]]; then
            actual_sum=$(command cksum < "$HOME/.zshenv")
            if [[ $actual_sum != "$expected_sum" ]]; then
                print -r -- "doctor: modified stub: $HOME/.zshenv"
                (( ++issues ))
            fi
        fi
    fi
fi
if [[ -n $fish_stub ]]; then
    fish_config=${${XDG_CONFIG_HOME:-$HOME/.config}%/}
    if [[ $fish_stub != "$fish_config/fish/conf.d/00-marksharc.fish" || ! -f $fish_stub || -L $fish_stub ]]; then
        print -r -- "doctor: missing or unmanaged fish stub: $fish_stub"
        (( ++issues ))
    elif [[ -n $fish_sum && ${(j: :)${=$(command cksum < "$fish_stub")}} != "${(j: :)${=fish_sum}}" ]]; then
        print -r -- "doctor: modified fish stub: $fish_stub"
        (( ++issues ))
    fi
fi
if [[ -L $config && ! -e $config ]]; then
    print -r -- "doctor: broken link: $config"
    (( ++issues ))
fi
if [[ $install_mode != coexist ]]; then
    source "$MARKSHARC_HOME/core/zsh/lib/zdot.zsh"
    zdot=${XDG_STATE_HOME:-$HOME/.local/state}/marksharc/zdot
    for name in zshenv zprofile zshrc zlogin; do
        expected="# Generated by marksharc (zdot v$_ms_zdot_version); do not edit. Regenerated when stale."$'\n'"[[ -r \${MARKSHARC_HOME-}/core/zsh/$name.zsh ]] && source \"\$MARKSHARC_HOME/core/zsh/$name.zsh\""
        if [[ ! -r $zdot/.$name || $(<"$zdot/.$name") != "$expected" ]]; then
            print -r -- "doctor: stale generated stub: $zdot/.$name"
            (( ++issues ))
        fi
    done
    if [[ ! -r $zdot/.version || $(<"$zdot/.version") != $_ms_zdot_version ]]; then
        print -r -- "doctor: stale generated stub version: $zdot/.version"
        (( ++issues ))
    fi
fi
print_dotfile_lines() {
    local file=$1 foreign_line
    integer line_no=0
    [[ -r $file ]] || return
    while IFS= read -r foreign_line || [[ -n $foreign_line ]]; do
        (( ++line_no ))
        print -r -- "  $line_no: $foreign_line"
    done < "$file"
}
if [[ $install_mode != coexist ]]; then
    if [[ -n $bash_sum ]]; then
        for bash_stub in "$HOME/.bashrc" "$HOME/.bash_profile"; do
            if [[ ! -f $bash_stub || -L $bash_stub ]]; then
                print -r -- "doctor: missing or unmanaged bash stub: $bash_stub"
                [[ ! -L $bash_stub ]] || print_dotfile_lines "$bash_stub"
                (( ++issues ))
            else
                actual_sum=$(command cksum < "$bash_stub")
                actual_sum=${(j: :)${=actual_sum}}
                if [[ $actual_sum != "$bash_sum" ]]; then
                    print -r -- "doctor: modified bash stub: $bash_stub"
                    print_dotfile_lines "$bash_stub"
                    (( ++issues ))
                fi
            fi
        done
    fi
    for dotfile in "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.zlogin" "$HOME/.zlogout" "$HOME/.bashrc" "${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"; do
        if [[ -e $dotfile || -L $dotfile ]]; then
            if [[ $dotfile == "$HOME/.bashrc" && -n $bash_sum ]]; then
                continue
            fi
            print -r -- "doctor: foreign dotfile: $dotfile"
            print_dotfile_lines "$dotfile"
            (( ++issues ))
        fi
    done
fi
# fisher is retired: marksharc pins the fish plugins it uses (spec 6.8).
fish_dir=${${XDG_CONFIG_HOME:-$HOME/.config}%/}/fish
for fisher_file in "$fish_dir/fish_plugins" "$fish_dir/functions/fisher.fish"; do
    [[ -e $fisher_file || -L $fisher_file ]] || continue
    print -r -- "doctor: fisher leftover (marksharc pins its fish plugins): $fisher_file"
    [[ $fisher_file != */fish_plugins ]] || print_dotfile_lines "$fisher_file"
    (( ++issues ))
done
typeset -A path_seen=()
typeset -a inspected_path=( "${path[@]}" )
if (( ${+MARKSHARC_DOCTOR_PATH} )); then inspected_path=( "${(@s/:/)MARKSHARC_DOCTOR_PATH}" ); fi
for entry in "${inspected_path[@]}"; do
    [[ -n $entry ]] || continue
    if [[ -n ${path_seen[$entry]-} ]]; then
        print -r -- "doctor: duplicate PATH: $entry"
        (( ++issues ))
    fi
    path_seen[$entry]=1
done
typeset -a candidates=( "$MARKSHARC_HOME" "$config" )
typeset -a extras=()
for conf in "$config/config.conf" "$config/hosts/${MARKSHARC_HOST:-${HOST%%.*}}.conf"; do
    [[ -r $conf ]] || continue
    while IFS= read -r line || [[ -n $line ]]; do
        _ms_words "$line" || continue
        if [[ ${reply[1]} == set && ${reply[2]-} == sync.repos ]] && (( $#reply >= 3 )); then
            extras=( "${reply[@]:2}" )
        fi
    done < "$conf"
done
candidates+=( "${extras[@]}" )
typeset -A seen=()
for candidate in "${candidates[@]}"; do
    [[ -d $candidate ]] || continue
    root=$(command git -C "${candidate:A}" rev-parse --show-toplevel 2>/dev/null) || continue
    root=${root:A}
    [[ -n ${seen[$root]-} ]] && continue
    seen[$root]=1
    if ! tree=$(command git -C "$root" status --porcelain --untracked-files=normal 2>/dev/null); then
        print -r -- "doctor: cannot inspect repository: $root"
        (( ++issues ))
    elif [[ -n $tree ]]; then
        print -r -- "doctor: dirty repository: $root"
        (( ++issues ))
    fi
    counts=$(command git -C "$root" rev-list --left-right --count 'HEAD...@{upstream}' 2>/dev/null) || continue
    typeset -a parts=( ${=counts} )
    if (( parts[1] > 0 || parts[2] > 0 )); then
        print -r -- "doctor: repository ahead ${parts[1]}, behind ${parts[2]}: $root"
        (( ++issues ))
    fi
done
inherited_id=${MARKSHARC_DOCTOR_ENV-${MARKSHARC_ENV-}}
if [[ -n $inherited_id ]]; then
    source "$MARKSHARC_HOME/core/zsh/lib/facts.zsh"
    source "$MARKSHARC_HOME/core/zsh/lib/envid.zsh"
    _ms_facts
    # The installer preserves a logical framework path, while the CLI resolves
    # its own path physically. The env ID hashes input paths as well as metadata.
    original_home=$MARKSHARC_HOME
    manifest=${XDG_STATE_HOME:-$HOME/.local/state}/marksharc/install.manifest
    if [[ -r $manifest ]]; then
        while IFS= read -r line; do
            if [[ $line == framework=* ]]; then
                installed_home=${line#framework=}
                [[ -d $installed_home && ${installed_home:A} == ${original_home:A} ]] && MARKSHARC_HOME=$installed_home
                break
            fi
        done < "$manifest"
    fi
    _ms_env_id
    MARKSHARC_HOME=$original_home
    if [[ -n $_ms_env_id_value && $inherited_id != $_ms_env_id_value ]]; then
        print -r -- 'doctor: stale environment ID (open a new shell or reload)'
        (( ++issues ))
    fi
fi
for name in "${_ms_mod_names[@]}"; do
    # "requires command" is a load condition: a module enabled by default skips itself
    # when the command is absent. Only a module the overlay names explicitly must have it.
    if [[ ${_ms_cfg_enabled[$name]-} == 1 ]]; then
        for required in ${=_ms_mod_req_cmd[$name]-}; do
            if ! whence -p -- "$required" >/dev/null 2>&1; then
                print -r -- "doctor: missing command: $required ($name)"
                (( ++issues ))
            fi
        done
    fi
    if [[ $name == cc-providers && ${_ms_mod_enabled[$name]-0} == 1 ]]; then
        provider_dir=${_ms_cfg_set[cc-providers.dir]-${_ms_mod_optdef[cc-providers.dir]-}}
        [[ -n $provider_dir ]] || provider_dir=$config/providers
        provider_files=( "$provider_dir"/*.conf(N-.) )
        legacy_providers=( "$provider_dir"/*.provider(N-.) )
        if (( ${#provider_files} == 0 )) && { (( ${#legacy_providers} > 0 )) || [[ ${_ms_cfg_enabled[$name]-} == 1 || -n ${_ms_cfg_set[cc-providers.dir]-} ]]; }; then
            print -r -- "doctor: cc-providers: no .conf provider files in $provider_dir (see docs/write-once.md)"
            (( ++issues ))
        elif (( ${#legacy_providers} > 0 )); then
            print -r -- "doctor: cc-providers: legacy .provider files in $provider_dir (see docs/write-once.md)"
            (( ++issues ))
        fi
    fi
    for registry in "${_ms_mod_dir[$name]}/zsh.plugins" "${_ms_mod_dir[$name]}/fish.plugins"; do
      [[ -r $registry ]] || continue
      while IFS= read -r line || [[ -n $line ]]; do
        _ms_words "$line" || continue
        [[ ${reply[1]} == plugin && -n ${reply[2]-} && -n ${reply[4]-} ]] || continue
        if [[ $name == node-nvm && $registry == */fish.plugins && ${reply[2]} == nvm.fish ]] && (( mise_owns_node )); then
            continue
        fi
        if [[ $name == completion-fzf-tab && $registry == */zsh.plugins && ${reply[2]} == fzf-tab ]] && (( carapace_active && ! carapace_allow_fzf_tab )); then
            continue
        fi
        plugin_dir=${XDG_CACHE_HOME:-$HOME/.cache}/marksharc/plugins/${reply[2]}@${reply[4]}
        if [[ ! -d $plugin_dir/.git ]] || [[ $(command git -C "$plugin_dir" rev-parse HEAD 2>/dev/null) != ${reply[4]} ]]; then
            print -r -- "doctor: missing plugin or incorrect pin: ${reply[2]} (run marksharc update)"
            (( ++issues ))
        fi
      done < "$registry"
    done
done
budget=${_ms_cfg_set[doctor.startup_ms]-500}
[[ $budget == <-> ]] || budget=500
timeout_ms=${_ms_cfg_set[doctor.startup_timeout_ms]-5000}
[[ $timeout_ms == <1-> ]] || timeout_ms=5000
if zmodload zsh/datetime 2>/dev/null && zmodload zsh/zpty 2>/dev/null && zmodload zsh/zselect 2>/dev/null && zmodload zsh/system 2>/dev/null; then
    started=$EPOCHREALTIME
    last_output=$started
    output= blocked_prompt=
    # A PTY makes the child an eligible interactive session. The marker also
    # verifies its session class and exit status; never launch notify from timing.
    if zpty -b msdoctor "print -r -- __MS_CHILD_PID__\$sysparams[pid]; unset CLAUDECODE AI_AGENT CODEX_SESSION_ID CODEX_SANDBOX OPENCODE GEMINI_CLI CURSOR_AGENT COPILOT_CLI KILO_CLI_MODE VSCODE_INJECTION VSCODE_NONCE; export MARKSHARC_NOTIFY=0; exec zsh -ic '[[ \$MARKSHARC_SESSION == interactive ]] && print -r -- __MS_INTERACTIVE_OK__; print -r -- __MS_CHILD_STATUS__\$?'"; then
        while (( (EPOCHREALTIME - started) * 1000 < timeout_ms )); do
            while (( (EPOCHREALTIME - started) * 1000 < timeout_ms )) && zpty -r -t msdoctor chunk 2>/dev/null; do
                output+=$chunk
                last_output=$EPOCHREALTIME
            done
            [[ $output == *__MS_CHILD_STATUS__* ]] && break
            zpty -t msdoctor || break
            # Only a known prompt at the current output tail can indicate a
            # blocked read. Give startup 250 ms without output to progress;
            # never answer prompts or weaken completion's security checks.
            if (( (EPOCHREALTIME - last_output) * 1000 >= 250 )); then
                prompt_line=${output//$'\r'/}
                prompt_line=${prompt_line##*$'\n'}
                case $prompt_line in
                    'Ignore insecure '*' and continue [y] or abort compinit [n]? '* | \
                    '--- Type one of the keys in parentheses --- ')
                        blocked_prompt=$prompt_line
                        break ;;
                esac
            fi
            zselect -t 5 2>/dev/null
        done
        # A menu may trap HUP (zpty -d's signal) and loop on a closed TTY.
        # Stop only our measured shell, whose PID was emitted before exec/startup.
        if [[ $output != *__MS_CHILD_STATUS__* ]] && zpty -t msdoctor; then
            child_pid=${${output#*__MS_CHILD_PID__}%%$'\r'*}
            child_pid=${child_pid%%$'\n'*}
            [[ $child_pid == <1-> ]] && kill -KILL -- "$child_pid" 2>/dev/null
        fi
        while zpty -r -t msdoctor chunk 2>/dev/null; do output+=$chunk; done
        zpty -d msdoctor 2>/dev/null
    fi
    elapsed=$(( (EPOCHREALTIME - started) * 1000 ))
    if [[ -n $blocked_prompt && $output != *__MS_CHILD_STATUS__* ]]; then
        print -r -- "doctor: interactive startup blocked waiting for input: $blocked_prompt"
        (( ++issues ))
    elif [[ $output != *__MS_CHILD_STATUS__* ]] && (( elapsed >= timeout_ms )); then
        print -r -- "doctor: interactive startup timed out after $timeout_ms ms"
        (( ++issues ))
    elif [[ $output != *__MS_INTERACTIVE_OK__* || $output != *__MS_CHILD_STATUS__0* ]]; then
        print -r -- 'doctor: interactive startup failed'
        (( ++issues ))
    elif (( elapsed > budget )); then
        printf 'doctor: startup budget exceeded: %.1f ms (budget %s ms)\n' "$elapsed" "$budget"
        (( ++issues ))
    else
        printf 'doctor: interactive startup %.1f ms (budget %s ms)\n' "$elapsed" "$budget"
    fi
else
    print -r -- 'doctor: interactive startup timing unavailable (zsh modules missing)'
    (( ++issues ))
fi
print -r -- "doctor: $issues issue(s)"
exit 0
