#!/bin/sh
# Shared offline dynamic completion candidate helper (COMPLETION-SPEC section 4).
# Translates Carapace's hyphenated C_FLAG_* env vars (such as C_FLAG_BASE-ONLY)
# before exec'ing zsh, which strips non-identifier names from environ on startup.
case " $* " in
    *" --from-carapace "*)
        if [ -z "${C_FLAG_BASE_ONLY:-}" ]; then
            _ms_bo=$(printenv C_FLAG_BASE-ONLY 2>/dev/null || :)
            if [ -n "$_ms_bo" ]; then export C_FLAG_BASE_ONLY="$_ms_bo"; fi
        fi
        ;;
esac
case $0 in
    */*) _ms_dir=${0%/*} ;;
    *) _ms_dir=. ;;
esac
exec zsh -f "$_ms_dir/complete.zsh" "$@"
