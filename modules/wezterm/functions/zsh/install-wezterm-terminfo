(
    emulate -L zsh
    local tempfile result
    tempfile=$(mktemp) || return 1
    {
        curl --fail --silent --show-error --location https://raw.githubusercontent.com/wezterm/wezterm/main/termwiz/data/wezterm.terminfo -o "$tempfile" || return $?
        tic -x -o "$HOME/.terminfo" "$tempfile"
    } always {
        result=$?
        rm -f -- "$tempfile"
    }
    return $result
)
