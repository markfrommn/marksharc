#!/usr/bin/env zsh
emulate -L zsh
tempfile=$(mktemp) || exit 1
trap 'rm -f -- "$tempfile"' EXIT
curl --fail --silent --show-error --location https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh -o "$tempfile" || exit $?
export NVM_DIR=${NVM_DIR:-$HOME/.nvm}
mkdir -p -- "$NVM_DIR" || exit $?
PROFILE=/dev/null bash "$tempfile"
