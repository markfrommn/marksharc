emulate -L zsh
typeset -ga _ms_session_functions
local owned collie_script='' rows row session state pid socket name
for owned in "${_ms_session_functions[@]}"; do unfunction "$owned" 2>/dev/null; done
_ms_session_functions=()
have_command herdr || return 0
if have_command collie; then
    collie_script=$(command -v collie)
fi
if [[ ! -x $collie_script ]]; then
    local -a candidates=( "$HOME"/.config/**/collie-ctl.sh(N-.x) )
    collie_script=${candidates[1]}
fi
rows=$(herdr session list) || return 1
# Supported table: name, state, PID, socket remainder (which may contain spaces).
local first=1
for row in "${(@f)rows}"; do
    if (( first )); then first=0; continue; fi
    [[ -n ${row//[[:space:]]/} ]] || continue
    read -r session state pid socket <<< "$row"
    [[ $session =~ '^[A-Za-z0-9_.-]+$' && -n $socket ]] || { print -ru2 'Unsupported Herdr session row'; return 1; }
    name=herdr-${session}
    functions[$name]="herdr session attach ${(q)session} \"\$@\""
    _ms_session_functions+=( "$name" )
    if [[ -n $collie_script ]]; then
        name=collie-${session}
        functions[$name]="HERDR_SOCKET_PATH=${(q)socket} ${(q)collie_script} \"\$@\""
        _ms_session_functions+=( "$name" )
    fi
done
return 0
