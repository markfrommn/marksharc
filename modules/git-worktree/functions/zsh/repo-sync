emulate -L zsh
local entry root result=0
local -a roots=( ${=_ms_opt_git_worktree_roots-} ) repos=()
if (( $#roots == 0 )); then
    print -ru2 'repo-sync: no roots configured (set git-worktree.roots)'
    return 1
fi
for root in $roots; do repos+=( ${root%/}/*/.git(N) ); done
for entry in "${repos[@]}"; do
    _ms_repo_sync_one "${entry:h}" || result=1
done
return $result
