#compdef launch-session

_launch_session_hosts() {
    local host trailing expl
    local -aU hosts=( local localhost remote )
    [[ -z $MARKSHARC_HOST ]] || hosts+=( "$MARKSHARC_HOST" )
    while IFS=$'\t' read -r host trailing; do
        [[ -n $host && $host != *' '* ]] && hosts+=( "$host" )
    done < <("$MARKSHARC_HOME/bin/marksharc" hosts list 2>/dev/null)
    if [[ $1 == target ]]; then
        hosts=( "${(@)hosts:#*:*}" )
        _wanted hosts expl 'launch host' compadd -r : -S : -a hosts
    else
        _wanted hosts expl 'launch host' compadd -a hosts
    fi
}

local context state state_descr line
local -A opt_args
_arguments -S -A '-*' \
    '(--help -h)'{--help,-h}'[Show usage]' \
    '--host[Choose a host]:host:_launch_session_hosts' \
    '--pwd[Set the starting directory]:directory:_files -/' \
    '--command[Choose a program]:program:_command_names' \
    '--mux[Choose a multiplexer]:multiplexer:(hc herdr tmux herdr-core)' \
    '--mux-id[Choose a multiplexer instance]:instance:' \
    '--place[Set terminal placement]:placement:(workspace tab hidden)' \
    '--name[Set a display name]:name:' \
    '*--env[Set a session variable]:NAME=VALUE:' \
    '--in-shell[Run after interactive startup]' \
    '--no-focus[Keep the current view]' \
    '--dry-run[Preview multiplexer commands]' \
    '--quiet[Suppress the result line]' \
    '1:target:->target' \
    '2:command:_command_names' \
    '*:argument:_files' && return 0

if [[ $state == target ]]; then
    if (( $+opt_args[--host] || $+opt_args[--pwd] || $+opt_args[--command] )); then
        _command_names
    elif (( $+opt_args[--] )); then
        _command_names
    else
        _alternative 'hosts:launch host: _launch_session_hosts target' 'directories:directory:_files -/'
    fi
fi
