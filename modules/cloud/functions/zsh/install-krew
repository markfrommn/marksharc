(
    emulate -L zsh
    local directory os arch archive result
    directory=$(mktemp -d) || return 1
    {
        cd -- "$directory" || return 1
        os=$(uname | tr '[:upper:]' '[:lower:]') || return 1
        arch=$(uname -m | sed -e 's/x86_64/amd64/' -e 's/\(arm\)\(64\)\?.*/\1\2/' -e 's/aarch64$/arm64/') || return 1
        archive=krew-${os}_${arch}
        curl -fsSLO "https://github.com/kubernetes-sigs/krew/releases/latest/download/${archive}.tar.gz" || return $?
        tar zxf "${archive}.tar.gz" && "./$archive" install krew
    } always {
        result=$?
        cd / && rm -rf -- "$directory"
    }
    return $result
)
