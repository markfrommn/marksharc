# Skip all of this if we are in a subshell

if [[ -n $HC_TERMINAL_ID ]]; then return 0; fi
if [ "$ZSH_SUBSHELL" != "0" ]; then
    return 0
fi

# And - for now - skip it all if we are not the primary shell
if [ "$SHLVL" != "1" ]; then
    return 0
fi

# And provide a way for our own scripts to skip the hook
if [ -n "$chdir_set_title_skip" ]; then
    return 0
fi

# We want the last two dirs of path to be informative but not too verbose, particularly for worktrees as it will show the repo
# We cannot seem to really set workspace name
  
local toppath=""
local dirname=""
local cwf_sname=""
local git_repo=""
local git_branch=""
local git_path=""
local normpwd=""
local source_name="zsh-chdir"
local hostname=$(hostname | awk -F. '{print $1}')
   
# Normalize our Mac paths
normpwd=${PWD/\/Users\/Shared//}

# Now replace HOME with ~
normpwd=${normpwd/$HOME\//\~/}

# Count slashes
local slashcount=${#normpwd//[^\/]}

# Now build our path strings based count
if [ $slashcount -lt 3 ]; then
    toppath="$hostname"
    dirname="$normpwd"
elif [ $slashcount -eq 3 ]; then
    toppath="${(j:/:)${(s:/:)normpwd}[-3,-3]}"
    dirname="${(j:/:)${(s:/:)normpwd}[-2,-1]}"
else
    toppath="${(j:/:)${(s:/:)normpwd}[-4,-3]}"
    dirname="${(j:/:)${(s:/:)normpwd}[-2,-1]}"
fi

local topprint="$dirname"
local subprint="$toppath"
local tabprint="$normpwd"
local paneprint="$normpwd"
local agentprint="$dirname"

# See if we have a session name
cwf_sname=$(cwf session name 2>/dev/null)
if [ $? -ne 0 ]; then
    cwf_sname=""
fi

# Then try to grab some git info
if git rev-parse --is-inside-work-tree >& /dev/null ; then
    git_repo=$(basename "$(git remote get-url origin 2>/dev/null)" .git)
    [[ -n $git_repo ]] || git_repo=${${$(git rev-parse --show-toplevel)}:t}
    git_branch=$(git symbolic-ref --quiet --short HEAD) || git_branch="detached-$(git rev-parse --short HEAD)"
    git_path=$(git rev-parse --show-prefix)
  
    topprint="$git_repo"
    subprint="$dirname"
    tabprint="$git_branch"
    paneprint="${git_path:-$dirname}"
    agentprint="$dirname"
fi

[[ -z $cwf_sname ]] || tabprint=$cwf_sname

# Various ways and cases to get the tab/pane title

# We check for herdr first as we might be in herdr in wezterm
if [ -n "$HC_TERMINAL_ID" ]; then
    # We are running under herdr core
    true
elif [ -n "$HERDR_TAB_ID" ]; then
    # We are running under herdr TUI
    #herdr pane report-metadata "$HERDR_PANE_ID" --source "$source_name" --token agent="$agentprint" >& /dev/null
    herdr workspace report-metadata "$HERDR_WORKSPACE_ID" --source "$source_name" --token topname="${topprint}-rm" >& /dev/null
    herdr workspace report-metadata "$HERDR_WORKSPACE_ID" --source "$source_name" --token subname="${subprint}" >& /dev/null
    herdr workspace rename "$HERDR_WORKSPACE_ID" "${topprint}" >& /dev/null
    herdr tab rename "$HERDR_TAB_ID" "${tabprint}" >& /dev/null
    herdr pane rename "$HERDR_PANE_ID" "${paneprint}" >& /dev/null
elif [ -n "$WEZTERM_PANE" ]; then
    wezterm cli set-tab-title "${tabprint}"
else
    set-title "${tabprint}"
fi
