#!/usr/bin/env zsh
emulate -L zsh
local running_containers dead_containers c
running_containers=$(docker ps | grep -E -v CONTAINER | awk '{print $1}')
if [[ -n $running_containers ]]; then
    print -n -- 'Killing running containers...'
    for c in ${=running_containers}; do
        docker kill "$c"
        print -n -- " $c "
    done
    print
else
    print 'No running containers.'
fi
dead_containers=$(docker ps -a | grep -E -v CONTAINER | awk '{print $1}')
if [[ -n $dead_containers ]]; then
    print -n -- 'Removing stopped containers...'
    for c in ${=dead_containers}; do
        docker rm "$c"
        print -n -- " $c "
    done
    print
else
    print 'No stopped containers.'
fi
