emulate -L zsh
typeset -ga _ms_cc_functions
local owned file pname vars key value assignments pkey pmurl header name dir quiet=0
local -a skipped
# -q: startup use; print nothing. A manual run reports what it defined and where it looked.
[[ $1 == -q ]] && quiet=1
dir=${_ms_opt_cc_providers_dir:-${MARKSHARC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/marksharc}/providers}
for owned in "${_ms_cc_functions[@]}"; do unfunction "$owned" 2>/dev/null; done
_ms_cc_functions=()
[[ -n $USER_KEY_DIR ]] || USER_KEY_DIR=$HOME/.private
for file in "$dir"/*.provider(N); do
    pname=${${file:t}%%-*}
    [[ $pname =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] || { print -ru2 "Invalid provider name: ${file:t}"; return 1; }
    vars=${pname}_provider
    unset "$vars"
    source "$file" || return 1
    (( ${(P)#vars} )) || { skipped+=( "$pname" ); continue; }
    assignments=''; pkey=''; pmurl=''
    for key value in "${(@Pkv)vars}"; do
        [[ $key =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]] || { print -ru2 "Invalid provider variable: $key"; return 1; }
        assignments+=" ${key}=${(q)value}"
        [[ $key != ANTHROPIC_AUTH_TOKEN ]] || pkey=$value
        [[ $key != MODELS_URL ]] || pmurl=$value
    done
    name=claude${pname}
    functions[$name]="$assignments command claude \"\$@\""
    _ms_cc_functions+=( "$name" )
    if [[ -n $pmurl ]]; then
        name=models${pname}; header="Authorization: Bearer $pkey"
        functions[$name]="emulate -L zsh; setopt pipefail; command curl --fail --silent --show-error ${(q)pmurl} -H ${(q)header} | command jq '.data[] .id'"
        _ms_cc_functions+=( "$name" )
    fi
done
if (( ! quiet )); then
    if (( ${#_ms_cc_functions} )); then
        print -r -- "cc-providers: ${_ms_cc_functions[*]} (from $dir)"
    elif (( ! ${#skipped} )); then
        print -r -- "cc-providers: no provider files in $dir"
    fi
    (( ! ${#skipped} )) || print -r -- "cc-providers: skipped ${skipped[*]} (provider file defined nothing)"
fi
return 0
