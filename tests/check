#!/bin/sh
# Run lint and the local shell suites. CI also runs the pinned-interpreter
# matrix and install and live PTY checks.
set -eu
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
"$here/lint"
"$here/run-tests" --shell zsh spec/zsh
"$here/run-tests" --shell sh spec/contract
"$here/run-tests" --shell sh spec/install
"$here/run-tests" --shell sh spec/repo
"$here/run-fish-units"
