# Agent configuration and cwf renders stay out of the repository (spec 6.2).
# Keep this block last: git applies the last matching rule, and cwf's
# generated blocks above may re-include agent paths.
AGENTS.md
AGENTS.override.md
CLAUDE.md
GEMINI.md
KILO.md
WARP.md
.agents/
.claude/
.codex/
.cursor/
.omp/
.vscode/
